# ============================================================
# CareStack Voice Charting — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_PASSWORD=cs_dev_password

# ─── JWT Authentication ──────────────────────────────────────
# Generate a strong secret for production:
#   openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-in-production

# ─── Deepgram STT ────────────────────────────────────────────
# Leave EMPTY for Mock Mode (pre-scripted dental utterances).
# Get a free API key at: https://console.deepgram.com
# Recommended model: nova-2-medical
DEEPGRAM_API_KEY=

# ─── Environment ─────────────────────────────────────────────
# development | production
ENV=development

# ─── Service Ports (optional overrides) ─────────────────────
# VOICE_SESSION_PORT=8080
